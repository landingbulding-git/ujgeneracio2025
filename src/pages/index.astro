---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import { Navbar } from '../components/Navbar';
import { Hero } from '../components/Hero';
import { CaseStudies } from '../components/CaseStudies';
import { Problems } from '../components/Problems';
import { Solution } from '../components/Solution';
import { Services } from '../components/Services';
import { HowItWorks } from '../components/HowItWorks';
import { Features } from '../components/Features';
import { About } from '../components/About';
import { Testimonials } from '../components/Testimonials';
import { CTABanner } from '../components/CTABanner';
import { WhyActNow } from '../components/WhyActNow';
import { FAQ } from '../components/FAQ';
import { Footer } from '../components/Footer';

import logoImg from '../assets/logo.jpg';
import heroImg from '../assets/hero.webp';
import aboutImg from '../assets/about.jpg';
import casestudy1Img from '../assets/casestudy1.webp';
import casestudy2Img from '../assets/casestudy2.webp';
import ctaBannerImg from '../assets/cta-banner.jpg';
import service1Img from '../assets/service1.jpeg';
import service2Img from '../assets/service2.webp';
import service3Img from '../assets/service3.webp';
import service4Img from '../assets/service4.webp';
import service5Img from '../assets/service5.webp';
import service6Img from '../assets/service6.webp';
---

<Layout title="Újgeneráció 2025">
	<main class="min-h-screen bg-white">
		<Navbar client:load>
			<Image src={logoImg} alt="Tiszta Víz" class="h-12 w-auto" slot="logoImage" widths={[52, 104]} sizes="52px" />
		</Navbar>
		<Hero client:load>
			<Image src={heroImg} alt="20+ év tapasztalat" class="w-full max-w-2xl object-cover rounded-2xl" slot="heroImage" widths={[400, 800, 1200]} sizes="(max-width: 768px) 100vw, 896px" />
		</Hero>
		<CaseStudies client:visible>
			<Image src={casestudy1Img} alt="Esettanulmány 1" class="w-full h-full object-cover rounded-2xl aspect-[4/3] shadow-lg" slot="image1" widths={[400, 800]} sizes="(max-width: 1024px) 100vw, 800px" />
			<Image src={casestudy2Img} alt="Esettanulmány 2" class="w-full h-full object-cover rounded-2xl aspect-[4/3] shadow-lg" slot="image2" widths={[400, 800]} sizes="(max-width: 1024px) 100vw, 800px" />
		</CaseStudies>
		<Problems />
		<Solution />
		<Services>
			<Image src={service1Img} alt="Vízlágyítás" class="w-full h-full object-cover" slot="image1" widths={[300, 600, 900]} sizes="(max-width: 768px) 100vw, 33vw" />
			<Image src={service2Img} alt="Ivóvíz-tisztítás" class="w-full h-full object-cover" slot="image2" widths={[300, 600, 900]} sizes="(max-width: 768px) 100vw, 33vw" />
			<Image src={service3Img} alt="Komplett kútvíz-kezelés" class="w-full h-full object-cover" slot="image3" widths={[300, 600, 900]} sizes="(max-width: 768px) 100vw, 33vw" />
			<Image src={service4Img} alt="Ipari és mezőgazdasági vízlágyítás" class="w-full h-full object-cover" slot="image4" widths={[300, 600, 900]} sizes="(max-width: 768px) 100vw, 33vw" />
			<Image src={service5Img} alt="Fordított ozmózis (RO) rendszerek" class="w-full h-full object-cover" slot="image5" widths={[300, 600, 900]} sizes="(max-width: 768px) 100vw, 33vw" />
			<Image src={service6Img} alt="NeoCrystal fizikai vízkezelés" class="w-full h-full object-cover" slot="image6" widths={[300, 600, 900]} sizes="(max-width: 768px) 100vw, 33vw" />
		</Services>
		<HowItWorks />
		<Features />
		<About>
			<Image src={aboutImg} alt="Lévay Ferenc Zoltán" class="w-full h-full object-cover" slot="aboutImage" widths={[300, 600, 900]} sizes="(max-width: 768px) 100vw, 40vw" />
		</About>
		<Testimonials />
		<CTABanner>
			<Image src={ctaBannerImg} alt="Hand washing" class="w-full h-auto aspect-video object-cover rounded-2xl shadow-sm" slot="ctaImage" widths={[400, 800, 1200]} sizes="(max-width: 768px) 100vw, 50vw" />
		</CTABanner>
		<WhyActNow />
		<FAQ client:visible />
		<Footer />
	</main>
</Layout>
